# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริงจาก Supabase Dashboard > Project Settings > API
# ห้าม commit ไฟล์ .env (อยู่ใน .gitignore แล้ว)

PORT=4000
CORS_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# ความลับ — ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามใส่ในโค้ดหน้าเว็บ
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# (ไม่บังคับ) รหัสผ่านบัญชีทดสอบ ถ้าไม่ตั้ง สคริปต์ seed จะสุ่มให้และบันทึกใน server/.seed-credentials.txt
# SEED_ADMIN_PASSWORD=
# SEED_EXECUTIVE_PASSWORD=

# (ไม่บังคับ แต่แนะนำ) ใช้กับ npm run db:apply เพื่อรัน schema.sql จากเครื่องโดยตรง
# Supabase > Project Settings > Database > Connection string > URI (แทนที่ [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูล)
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
